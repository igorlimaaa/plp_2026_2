    {
      "id": "1793558045065-el2iiem",
      "name": "Sem exceção: o catch não roda e o finally roda",
      "languageName": "OO1",
      "notebookScopeEnabled": false,
      "createdAt": "2026-11-01T18:34:05.065Z",
      "updatedAt": "2026-11-01T18:35:34.387Z",
      "cells": [
        {
          "id": "1793558078793-3x999dl",
          "type": "code",
          "content": "{\n  classe C {\n    int x = 0;\n    proc f() {\n      skip\n    }\n  };\n  {\n    C c := new C;\n    try {\n      write(\"sem erro\")\n    } catch (e) {\n      write(\"nao deve aparecer\")\n    } finally {\n      write(\"finally sempre roda\")\n    }\n  }\n}",
