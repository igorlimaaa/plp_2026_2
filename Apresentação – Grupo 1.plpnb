    {
      "id": "1793558546954-vi2pn80",
      "name": "Try aninhado com throw dentro do catch",
      "languageName": "OO1",
      "notebookScopeEnabled": false,
      "createdAt": "2026-11-01T18:42:26.954Z",
      "updatedAt": "2026-11-04T22:42:17.891Z",
      "cells": [
        {
          "id": "1793558550500-ahcnq24",
          "type": "code",
          "content": "{\n  classe C { int x = 0; proc f() { skip } };\n  {\n    C c := new C;\n    try {\n      try {\n        throw \"interno\"\n      }\n      catch (e) {\n        throw \"relancado\"\n      }\n    } catch (e2) {\n      write(\"externo pegou: \" ++ e2)\n    }\n  }\n}",
          "createdAt": "2026-11-01T18:42:30.500Z",
          "updatedAt": "2026-11-04T22:39:44.180Z",
          "input": "",
          "output": {
            "stdout": "externo pegou: relancado ",
