    {
      "id": "1793558599507-3jr3gq1",
      "name": "Conta Bancária",
      "languageName": "OO1",
      "notebookScopeEnabled": false,
      "createdAt": "2026-11-01T18:43:19.507Z",
      "updatedAt": "2026-11-04T22:41:43.502Z",
      "cells": [
        {
          "id": "1793558616187-cz0pxq7",
          "type": "code",
          "content": "{\n  classe ContaBancaria {\n    int saldo = 100;\n\n    proc sacar(int valor) {\n      // defer: executado obrigatoriamente ao finalizar a execução do método (ordem LIFO)\n      defer write(\"1. [defer] Registro de auditoria gravado no log.\");\n\n      try {\n        defer write(\"2. [defer] Estado do objeto conta liberado.\");\n        if valor > this.saldo then {\n          throw \"Saldo insuficiente para o saque\"\n        };\n        this.saldo := this.saldo - valor;\n        write(\"Saque efetuado com sucesso. Saldo restante: \" ++ this.saldo)\n      } catch (erro) {\n        write(\"Falha ao processar saque: \" ++ erro);\n        defer write(\"4. [defer] Operação inválida.\")\n      } finally {\n        // finally: executado obrigatoriamente ao final da estrutura try/catch\n        write(\"3. [finally] Bloco de confirmacao concluido.\")\n      }\n    }\n  };\n\n  {\n    ContaBancaria minhaConta := new ContaBancaria;\n    minhaConta.sacar(150)\n  }\n}",
          "createdAt": "2026-11-01T18:43:36.187Z",
          "updatedAt": "2026-11-04T22:41:43.502Z",
          "input": "",
          "output": {
            "stdout": "Falha ao processar saque: Saldo insuficiente para o saque 3. [finally] Bloco de confirmacao concluido. 4. [defer] Operação inválida. 2. [defer] Estado do objeto conta liberado. 1. [defer] Registro de auditoria gravado no log. ",
            "stderr": "sintaxe verificada com sucesso!",
            "result": "Falha ao processar saque: Saldo insuficiente para o saque 3. [finally] Bloco de confirmacao concluido. 4. [defer] Operação inválida. 2. [defer] Estado do objeto conta liberado. 1. [defer] Registro de auditoria gravado no log. ",
            "compilationEnv": {
              "languageId": "oo1",
              "frames": [
                {
                  "name": "ContaBancaria",
                  "scope": "class",
                  "bindings": {
                    "saldo": {
                      "type": "TipoPrimitivo",
