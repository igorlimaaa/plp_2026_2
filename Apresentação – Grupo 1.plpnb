    {
      "id": "1793558343817-vsvhnd1",
      "name": "Defer com exceção externa",
      "languageName": "OO1",
      "notebookScopeEnabled": false,
      "createdAt": "2026-11-01T18:39:03.817Z",
      "updatedAt": "2026-11-04T22:42:14.108Z",
      "cells": [
        {
          "id": "1793558346156-nxkb95l",
          "type": "code",
          "content": "{\n  classe C {\n    int saldo = 10;\n    proc g(int n) {\n      defer write(\"END\");\n      write(\"START\");\n      if n > this.saldo\n      then {\n        throw \"estourou!\"\n      } else {\n        write(\"OK\")\n      }\n    }\n  };\n  {\n    C c := new C;\n    try {\n      c.g(50)\n    } catch (e) {\n      write(\"pegou erro: \" ++ e)\n    }\n  }\n}",
          "createdAt": "2026-11-01T18:39:06.156Z",
          "updatedAt": "2026-11-04T22:35:04.761Z",
          "input": "",
          "output": {
            "stdout": "START END pegou erro: estourou! ",
            "stderr": "sintaxe verificada com sucesso!",
            "result": "START END pegou erro: estourou! ",
